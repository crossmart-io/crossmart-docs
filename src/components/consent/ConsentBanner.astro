---
/**
 * The cookie banner: a corner card that asks once, then stays out of the way. It renders only
 * when a GA4 Measurement ID is configured, and its script loads gtag.js only after "Accept".
 */
import CookieIcon from './CookieIcon.astro';
import { ConsentChoice, GA_MEASUREMENT_ID } from '../../data/analytics';
import { CONSENT_COPY } from '../../data/consent';

const messageId = 'consent-message';
---

{GA_MEASUREMENT_ID && (
  <section
    class="consent not-content"
    data-consent-banner
    aria-label={CONSENT_COPY.label}
    aria-describedby={messageId}
    tabindex="-1"
    hidden
  >
    <div class="consent__body">
      <span class="consent__icon">
        <CookieIcon />
      </span>
      <p id={messageId}>
        {CONSENT_COPY.message} <a href={CONSENT_COPY.privacyHref}>{CONSENT_COPY.privacyLabel}</a>
      </p>
    </div>
    <div class="consent__actions">
      <button
        type="button"
        class="consent__button"
        data-consent-choice
        value={ConsentChoice.Denied}
      >
        {CONSENT_COPY.reject}
      </button>
      <button
        type="button"
        class="consent__button"
        data-consent-choice
        value={ConsentChoice.Granted}
      >
        {CONSENT_COPY.accept}
      </button>
    </div>
  </section>
)}

{GA_MEASUREMENT_ID && <script>
  import { initConsent } from '../../scripts/analytics/consent-banner';
  initConsent();
</script>}

<style>
  /* Bottom-left over the page, in Starlight's colours so it follows the light and dark themes. */
  .consent {
    position: fixed;
    inset-block-end: 1.5rem;
    inset-inline-start: 1.5rem;
    z-index: var(--sl-z-index-navbar);
    display: grid;
    gap: 1rem;
    width: min(26rem, 100vw - 3rem);
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: var(--sl-shadow-lg);
  }
  .consent[hidden] {
    display: none;
  }
  .consent:focus {
    outline: none;
  }
  .consent:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .consent:not([hidden]) {
      animation: consent-enter 180ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes consent-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .consent__body {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .consent__icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
  }
  .consent__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .consent p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .consent a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  /* Accept and Reject look the same on purpose: neither answer is nudged. */
  .consent__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .consent__button {
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-family: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      transform 120ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .consent__button:active {
    transform: scale(0.97);
  }
  .consent__button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .consent__button:hover {
      border-color: var(--sl-color-gray-3);
    }
  }

  @media (max-width: 40rem) {
    .consent {
      inset-inline: 1rem;
      inset-block-end: 1rem;
      width: auto;
    }
  }
</style>
