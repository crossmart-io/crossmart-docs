{
  "name": "crossmart-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Crossmart documentation: docs.crossmart.io",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pnpm build:markdown && pnpm build:nginx",
    "build:markdown": "node scripts/build-markdown.ts",
    "build:nginx": "node scripts/build-nginx-snippets.ts",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "check:links": "node scripts/check-built-links.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.9",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-openapi": "^0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "hast-util-select": "^6.0.4",
    "hast-util-to-string": "^3.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "^1.11.3"
    }
  },
  "license": "(MIT AND CC-BY-4.0)"
}
